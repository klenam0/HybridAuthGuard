# Copy this file to .env and fill in your own values.
# Never commit the real .env file.

# Gmail SMTP — used to email HIGH-severity alerts (v3: incidents in the
# block or step-up tier; legacy: HIGH-severity alerts).
# Leave blank to disable email alerting (the system runs fine without it).
# EMAIL_PASSWORD must be a Gmail *app password*, not your account password:
# https://support.google.com/accounts/answer/185833
EMAIL_SENDER=
EMAIL_PASSWORD=
EMAIL_RECEIVER=

# Admin token: required for /api/run, clearing or restoring alerts, and
# clearing the live queue (header X-Admin-Token). The dashboard asks for it
# at runtime; it is never built into the frontend. CLEAR_TOKEN is still
# accepted as the older name. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=

# Ingest token: required by /api/ingest (header X-Ingest-Token). Give this,
# not the admin token, to log sources; live_simulator.py reads it from here.
INGEST_TOKEN=

# Optional: SHA-256 of backend/data/model.pkl. When set, the model is only
# unpickled if its hash matches (loading a pickle runs code from it).
# MODEL_SHA256=

# Optional: browser origins allowed to call the API (comma-separated).
# DASHBOARD_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Path to the RBA Dataset CSV; only needed to retrain.
# Defaults to backend/data/rba-dataset.csv if unset.
# RBA_DATASET_PATH=/path/to/rba-dataset.csv

# Engine and policy (backend/config.py). Defaults since Phase 5: the v3 rule
# engine with the incident response tiers, and ML mode v4 (no label-filtered
# model). Set both to "legacy" for the original Phase 0-2 system.
# RULES_MODE=v3
# ML_MODE=v4

# v3 incident email: one per incident entering the block or step-up tier,
# at most EMAIL_MAX_PER_HOUR per hour (the rest go into an hourly digest),
# at most one per IP per EMAIL_IP_COOLDOWN_SECONDS.
# EMAIL_MAX_PER_HOUR=20
# EMAIL_IP_COOLDOWN_SECONDS=86400

# v3 alert store (backend/data/alerts.db): alerts saved more than this many
# days ago are pruned on start and daily; 0 keeps everything.
# ALERT_RETENTION_DAYS=30
