# Copy this file to .env and fill in your own values.
# Never commit the real .env file.

# Gmail SMTP — used to email HIGH-severity alerts.
# Leave blank to disable email alerting (the system runs fine without it).
# EMAIL_PASSWORD must be a Gmail *app password*, not your account password:
# https://support.google.com/accounts/answer/185833
EMAIL_SENDER=
EMAIL_PASSWORD=
EMAIL_RECEIVER=

# Bearer token required to clear alerts / the live event queue via the API.
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
CLEAR_TOKEN=

# Path to the RBA Dataset CSV; only needed to retrain.
# Defaults to backend/data/rba-dataset.csv if unset.
# RBA_DATASET_PATH=/path/to/rba-dataset.csv
