# ── Secrets — never commit ────────────────────────────────────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
backend/.env
frontend/.env

# ── Python ───────────────────────────────────────────────────────────────
backend/__pycache__/
backend/**/__pycache__/
*.pyc
backend/venv/
backend/.venv/
backend/env/

# ── Backend runtime data (regenerated automatically by the pipeline) ──────
backend/data/alerts.json
backend/data/alerts.json.bak
backend/data/pipeline_stats.json
backend/data/raw_logs.txt
backend/data/parsed_logs.json
backend/data/live_queue.jsonl
backend/data/live_queue.jsonl.cursor
backend/data/training_logs.json
backend/data/training_sample.csv
backend/data/eval_sample.csv
# RBA Dataset CSV (download separately, see docs/SETUP.md)
backend/data/rba-dataset.csv
backend/data/*.csv
backend/data/*.lock
backend/data/*.tmp
backend/data/.alerts-*.tmp
backend/data/alerts.json.corrupt-*
backend/data/live_queue.deadletter.jsonl
backend/data/model.pkl.replaced-*
# Month-partitioned Parquet of the RBA CSV and the locked test month
# (backend/eval/convert_rba.py, backend/eval/PROTOCOL.md)
backend/data/rba_parquet/
backend/data/rba_locked/

#results 
backend/results/batch4_results.json
backend/results/batch5_results.json
backend/results/batch5b_results.json

# Pickled caches and models are never committed: they are large, and
# loading a pickle runs code from it (audit F31).
*.pkl
backend/results/rba_sample_cache.pkl

# model.pkl is about 390 MB — too large for direct commit or Git LFS's free
# bandwidth quota. Distributed via GitHub Releases instead — see
# docs/SETUP.md for the download link. model_metrics.json IS tracked
# (small, just evaluation numbers).
backend/data/model.pkl

# ── Node / React ───────────────────────────────────────────────────────────
frontend/node_modules/
frontend/build/
frontend/coverage/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── OS / editor cruft ───────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# ── Local AI/editor tooling ─────────────────────────────────────────────
.claude/
frontend/.claude/
frontend/skills-lock.json

# Phase 3 evaluation intermediates (backend/eval/phase3_rules.py)
backend/results/phase3_cache/
# Phase 3b evaluation intermediates (backend/eval/phase3b.py)
backend/results/phase3b_cache/
# Phase 4 evaluation intermediates (backend/eval/phase4.py)
backend/results/phase4_cache/
